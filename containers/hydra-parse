#!/usr/bin/env python3
"""hydra-parse — compact JSON summary from hydra credential brute-force output.

Reads hydra plain text output written with -o results.txt.
Hydra text format: [PORT][SERVICE] host: HOST   login: USER   password: PASS

Usage:
  hydra -l admin -P /opt/SecLists/... ssh://target -o /tmp/hydra.txt
  hydra-parse /tmp/hydra.txt

  hydra ... | hydra-parse -
"""
import sys, json, re

CRED_PAT = re.compile(
    r'\[(\d+)\]\[(\w[\w-]*)\]\s+host:\s+(\S+)\s+login:\s+(\S+)\s+password:\s+(.+)'
)

def main():
    src = sys.argv[1] if len(sys.argv) > 1 else "-"
    text = (open(src) if src != "-" else sys.stdin).read()

    creds = []
    errors = []
    for line in text.splitlines():
        m = CRED_PAT.search(line)
        if m:
            creds.append({
                "port":     m.group(1),
                "service":  m.group(2),
                "host":     m.group(3),
                "user":     m.group(4),
                "password": m.group(5).strip(),
            })
        elif any(kw in line.lower() for kw in ("error", "invalid", "failed", "could not")):
            errors.append(line.strip()[:120])

    print(json.dumps({
        "found":       len(creds),
        "credentials": creds,
        "errors":      errors[:5],
    }, indent=2))

if __name__ == "__main__":
    main()
