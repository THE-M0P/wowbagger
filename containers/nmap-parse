#!/usr/bin/env bash
# nmap-parse — compact JSON summary from nmap -oN or -oX output.
# Usage:
#   nmap -sV -p- target -oN /tmp/scan.txt && nmap-parse /tmp/scan.txt
#   nmap -sV -p- target -oX /tmp/scan.xml && nmap-parse /tmp/scan.xml

set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "Usage: nmap-parse <nmap-output-file>" >&2
    exit 1
fi

FILE="$1"
[[ -f "$FILE" ]] || { echo "Error: File not found: $FILE" >&2; exit 1; }

# XML path — use python for reliable parsing
if head -1 "$FILE" | grep -q '<?xml'; then
    python3 - "$FILE" <<'PY'
import sys, json, xml.etree.ElementTree as ET

tree = ET.parse(sys.argv[1])
root = tree.getroot()

hosts = []
for host in root.findall("host"):
    addr_el = host.find("address[@addrtype='ipv4']") or host.find("address[@addrtype='ipv6']")
    if addr_el is None:
        continue
    ip = addr_el.get("addr", "")
    hostname = ""
    hn = host.find("hostnames/hostname")
    if hn is not None:
        hostname = hn.get("name", "")
    status = host.find("status")
    if status is not None and status.get("state") != "up":
        continue
    ports = []
    for port in host.findall("ports/port"):
        state_el = port.find("state")
        if state_el is None or state_el.get("state") != "open":
            continue
        svc = port.find("service") or {}
        name = svc.get("name", "") if isinstance(svc, ET.Element) else ""
        product = svc.get("product", "") if isinstance(svc, ET.Element) else ""
        version = svc.get("version", "") if isinstance(svc, ET.Element) else ""
        ports.append({
            "port": int(port.get("portid", 0)),
            "proto": port.get("protocol", "tcp"),
            "service": name,
            "version": f"{product} {version}".strip(),
        })
    if ports:
        hosts.append({"ip": ip, "hostname": hostname, "open_ports": len(ports), "ports": ports})

total_ports = sum(h["open_ports"] for h in hosts)
print(json.dumps({"hosts": len(hosts), "total_open_ports": total_ports, "results": hosts}, indent=2))
PY
    exit 0
fi

# Normal text format (-oN)
python3 - "$FILE" <<'PY'
import sys, re, json

hosts = []
current = None

for line in open(sys.argv[1]):
    line = line.rstrip()
    m = re.match(r'Nmap scan report for (.+)', line)
    if m:
        if current:
            hosts.append(current)
        label = m.group(1)
        ip_m = re.search(r'\((\d+\.\d+\.\d+\.\d+)\)', label)
        ip = ip_m.group(1) if ip_m else label
        hostname = label.split()[0] if ip_m else ""
        current = {"ip": ip, "hostname": hostname, "open_ports": 0, "ports": []}
        continue
    if current is None:
        continue
    m = re.match(r'(\d+)/(tcp|udp)\s+open\s+(\S+)\s*(.*)', line)
    if m:
        current["open_ports"] += 1
        current["ports"].append({
            "port": int(m.group(1)),
            "proto": m.group(2),
            "service": m.group(3),
            "version": m.group(4).strip(),
        })

if current:
    hosts.append(current)

total_ports = sum(h["open_ports"] for h in hosts)
print(json.dumps({"hosts": len(hosts), "total_open_ports": total_ports, "results": hosts}, indent=2))
PY
