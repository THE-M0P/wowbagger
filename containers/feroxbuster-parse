#!/usr/bin/env python3
"""feroxbuster-parse — compact JSON summary from feroxbuster NDJSON output.

Reads feroxbuster output written with --json -o /tmp/ferox.json.
Each line is a JSON object with type "response" or "statistics".
Groups by status; caps at 25 per bucket. Flags interesting paths.

Usage:
  feroxbuster -u http://target/ -w /opt/SecLists/Discovery/Web-Content/raft-medium-files.txt \
              --json -o /tmp/ferox.json --silent
  feroxbuster-parse /tmp/ferox.json
"""
import sys, json, re

INTERESTING_RE = re.compile(
    r'/(admin|api|backup|config|debug|env|git|graphql|internal|login|panel'
    r'|secret|swagger|phpinfo|\.env|\.git|upload|shell|console|actuator)',
    re.IGNORECASE
)

def main():
    src = sys.argv[1] if len(sys.argv) > 1 else "-"
    lines = (open(src) if src != "-" else sys.stdin).readlines()

    responses = []
    stats = {}

    for line in lines:
        line = line.strip()
        if not line:
            continue
        try:
            obj = json.loads(line)
        except json.JSONDecodeError:
            continue
        t = obj.get("type", "")
        if t == "response":
            responses.append(obj)
        elif t == "statistics":
            stats = obj

    by_status = {}
    interesting = []

    for r in responses:
        status = str(r.get("status", "?"))
        url = r.get("url", "")
        length = r.get("content_length", r.get("length", 0))
        method = r.get("method", "GET")
        entry = {"status": status, "url": url, "length": length, "method": method}
        by_status.setdefault(status, []).append(entry)
        if INTERESTING_RE.search(url):
            interesting.append(entry)

    trimmed = {s: bucket[:25] for s, bucket in by_status.items()}

    out = {
        "total": len(responses),
        "by_status": {s: len(v) for s, v in by_status.items()},
        "interesting": interesting[:20],
        "results": trimmed,
    }
    if stats:
        out["stats"] = {
            "requests": stats.get("requests", 0),
            "errors": stats.get("errors", 0),
            "timeouts": stats.get("timeouts", 0),
        }
    print(json.dumps(out, indent=2))

if __name__ == "__main__":
    main()
